            "image_ratio": "rounded",
            "image_height": 30,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "t5": {
          "type": "testimonial",
          "settings": {
            "icon": "quote",
            "text": "<p>\"I was skeptical about the price difference over Pro but after two weeks with Elite I get it. Faster, smoother, and split-screen is genuinely useful every single day.\"</p>",
            "author": "Stephanie L.",
            "author_info": "2022 Hyundai Tucson \u2014 Verified Buyer",
            "author_url": "",
            "image_ratio": "rounded",
            "image_height": 30,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "t6": {
          "type": "testimonial",
          "settings": {
            "icon": "quote",
            "text": "<p>\"The enhanced UI actually looks premium. My car screen looks like something from a $100k vehicle. Everyone who gets in asks what I did to my car. Best $200 I've ever spent.\"</p>",
            "author": "Brian W.",
            "author_info": "2019 Kia Telluride \u2014 Verified Buyer",
