    "testimonials-1": {
      "type": "testimonials-banner",
      "blocks": {
        "t1": {
          "type": "testimonial",
          "settings": {
            "icon": "quote",
            "text": "<p>\"I've had the Pro for a year and finally upgraded to Elite. The split-screen alone is worth it \u2014 I run Waze on one side and Spotify on the other. It's a completely different experience.\"</p>",
            "author": "Daniel M.",
            "author_info": "2022 Toyota RAV4 \u2014 Verified Buyer",
            "author_url": "",
            "image_ratio": "rounded",
            "image_height": 30,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "t2": {
          "type": "testimonial",
          "settings": {
            "icon": "quote",
            "text": "<p>\"My kids watch Netflix while I use Google Maps. No sharing the screen, no switching apps. Elite just handles everything at once. My whole family uses this car differently now.\"</p>",
            "author": "Rachel T.",
            "author_info": "2021 Honda Pilot \u2014 Verified Buyer",
            "author_url": "",
            "image_ratio": "rounded",
            "image_height": 30,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "t3": {
          "type": "testimonial",
          "settings": {
            "icon": "quote",
            "text": "<p>\"Spent a week comparing Pro vs Elite. The 8GB RAM makes a real difference \u2014 apps open faster, never lag, never crash. If you're going to buy one, skip the Pro and get Elite.\"</p>",
            "author": "Kevin A.",
            "author_info": "2020 BMW 3 Series \u2014 Verified Buyer",
            "author_url": "",
            "image_ratio": "rounded",
            "image_height": 30,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
      "block_order": [
        "t1",
        "t2",
