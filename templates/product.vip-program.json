    "testimonials": {
      "type": "testimonials-banner",
      "blocks": {
        "t1": {
          "type": "testimonial",
          "settings": {
            "icon": "quote",
            "text": "<p>\"Joined VIP on a whim and the $20 credit covered most of my next order. The 15% off is basically already paid for itself after two purchases. No-brainer.\"</p>",
            "author": "Marcus T.",
            "author_info": "AutoLinkr Pro\u2122 Owner \u2014 Verified Member",
            "author_url": "",
            "image_ratio": "rounded",
            "image_height": 30,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "t2": {
          "type": "testimonial",
          "settings": {
            "icon": "quote",
            "text": "<p>\"Between the instant credit and the discount on every order, this is the easiest $9.99 I've ever spent. Already ordered accessories and saved way more than the membership cost.\"</p>",
            "author": "Jess R.",
            "author_info": "AutoLinkr Elite\u2122 Owner \u2014 Verified Member",
            "author_url": "",
            "image_ratio": "rounded",
            "image_height": 30,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "t3": {
          "type": "testimonial",
          "settings": {
            "icon": "quote",
            "text": "<p>\"The priority support alone is worth it. Had a setup question and heard back in under an hour. That never happens anywhere else.\"</p>",
            "author": "Derek M.",
            "author_info": "AutoLinkr Pro\u2122 Owner \u2014 Verified Member",
            "author_url": "",
            "image_ratio": "rounded",
            "image_height": 30,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
