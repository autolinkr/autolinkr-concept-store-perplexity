    "faq": {
      "type": "faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "title": "Is this a subscription? Will I be charged again?",
            "text": "<p>No. AutoLinkr VIP Membership is a one-time payment of $9.99. You are never charged again. There is no auto-renewal, no monthly fee, and no cancellation required.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "title": "When do I receive the $20 store credit?",
            "text": "<p>Your $20 store credit is sent automatically to the email address on your order shortly after your purchase is confirmed. No action required on your part.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "title": "How does the 15% discount work?",
            "text": "<p>Once you become a VIP member, the 15% discount is applied automatically at checkout on every future order placed with the same account. You don't need a coupon code \u2014 it just works.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "title": "What are the quarterly gifts?",
            "text": "<p>Every quarter, VIP members receive a free AutoLinkr product or accessory shipped to them \u2014 no purchase necessary. The product varies each quarter and is chosen by our team. Gifts begin 90 days after your membership purchase.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "title": "Does the 1-year warranty apply to past purchases?",
            "text": "<p>The extended 1-year warranty applies to all AutoLinkr purchases made while you are an active VIP member. It does not apply retroactively to purchases made before joining.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "title": "What does priority support mean?",
            "text": "<p>VIP members are flagged in our support system and receive faster response times and elevated handling. Email us at support@theautolinkr.com and mention your VIP membership.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q7": {
          "type": "question",
          "settings": {
            "title": "Can I share my membership with someone else?",
            "text": "<p>Membership is non-transferable and tied to the purchasing account. Each person must purchase their own membership to receive the benefits.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
