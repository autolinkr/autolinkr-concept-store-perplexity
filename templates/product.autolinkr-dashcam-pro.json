      "blocks": {
        "t1": {
          "type": "testimonial",
          "settings": {
            "icon": "quote",
            "text": "<p>\"The video clarity and overall build quality of this system are truly outstanding — far better than I expected, especially given the affordable price. I can read license plates at a reasonable distance, which is something you typically only find in systems that cost much more.\"<\/p>",
            "author": "Steven",
