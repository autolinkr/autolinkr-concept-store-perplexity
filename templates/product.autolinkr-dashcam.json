        "question_xH9dRz": {
          "type": "question",
          "settings": {
            "title": "Does it work without WiFi?",
            "text": "<p>Yes. The Dash records to the SD card at all times, with or without WiFi. The WiFi is only needed to preview or download clips to your phone.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_UEKLiJ": {
          "type": "question",
          "settings": {
            "title": "What SD card do I need?",
            "text": "<p>Any Class 10 MicroSD card up to 128GB works perfectly. Or choose the 32GB or 64GB pre-installed options at checkout to skip this step entirely.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_jNxHfP": {
          "type": "question",
          "settings": {
            "title": "Will it drain my battery?",
            "text": "<p>No — the Dash draws power from your 12V port and stops when the car turns off. For parking mode, use the included hardwire kit which has a low-voltage cutoff to protect your battery.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
