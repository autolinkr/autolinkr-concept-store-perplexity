{% doc %}
  @prompt
    A divider using cool shapes to divide up sections fluidly with good configurations
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-fluid-divider-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    overflow: hidden;
    line-height: 0;
    margin: {{ block.settings.spacing_top }}px 0 {{ block.settings.spacing_bottom }}px;
  }

  .ai-fluid-divider-{{ ai_gen_id }} svg {
    display: block;
    width: calc(100% + 1.3px);
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    height: {{ block.settings.divider_height }}px;
  }

  .ai-fluid-divider-{{ ai_gen_id }}--flip-horizontal svg {
    transform: translateX(-50%) scaleX(-1);
  }

  .ai-fluid-divider-{{ ai_gen_id }}--flip-vertical svg {
    transform: translateX(-50%) scaleY(-1);
  }

  .ai-fluid-divider-{{ ai_gen_id }}--flip-both svg {
    transform: translateX(-50%) scale(-1, -1);
  }

  @media screen and (max-width: 749px) {
    .ai-fluid-divider-{{ ai_gen_id }} svg {
      height: {{ block.settings.divider_height_mobile }}px;
    }
  }
{% endstyle %}

<div
  class="ai-fluid-divider-{{ ai_gen_id }} {% if block.settings.flip_horizontal and block.settings.flip_vertical %}ai-fluid-divider-{{ ai_gen_id }}--flip-both{% elsif block.settings.flip_horizontal %}ai-fluid-divider-{{ ai_gen_id }}--flip-horizontal{% elsif block.settings.flip_vertical %}ai-fluid-divider-{{ ai_gen_id }}--flip-vertical{% endif %}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.shape_style == 'waves' %}
    <svg
      viewBox="0 0 1200 120"
      preserveAspectRatio="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M0,0V46.29c47.79,22.2,103.59,32.17,158,28,70.36-5.37,136.33-33.31,206.8-37.5C438.64,32.43,512.34,53.67,583,72.05c69.27,18,138.3,24.88,209.4,13.08,36.15-6,69.85-17.84,104.45-29.34C989.49,25,1113-14.29,1200,52.47V0Z"
        opacity=".25"
        fill="{{ block.settings.divider_color }}"
      ></path>
      <path
        d="M0,0V15.81C13,36.92,27.64,56.86,47.69,72.05,99.41,111.27,165,111,224.58,91.58c31.15-10.15,60.09-26.07,89.67-39.8,40.92-19,84.73-46,130.83-49.67,36.26-2.85,70.9,9.42,98.6,31.56,31.77,25.39,62.32,62,103.63,73,40.44,10.79,81.35-6.69,119.13-24.28s75.16-39,116.92-43.05c59.73-5.85,113.28,22.88,168.9,38.84,30.2,8.66,59,6.17,87.09-7.5,22.43-10.89,48-26.93,60.65-49.24V0Z"
        opacity=".5"
        fill="{{ block.settings.divider_color }}"
      ></path>
      <path
        d="M0,0V5.63C149.93,59,314.09,71.32,475.83,42.57c43-7.64,84.23-20.12,127.61-26.46,59-8.63,112.48,12.24,165.56,35.4C827.93,77.22,886,95.24,951.2,90c86.53-7,172.46-45.71,248.8-84.81V0Z"
        fill="{{ block.settings.divider_color }}"
      ></path>
    </svg>
  {% elsif block.settings.shape_style == 'curve' %}
    <svg
      viewBox="0 0 1200 120"
      preserveAspectRatio="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M0,0V7.23C0,65.52,268.63,112.77,600,112.77S1200,65.52,1200,7.23V0Z"
        fill="{{ block.settings.divider_color }}"
      ></path>
    </svg>
  {% elsif block.settings.shape_style == 'triangle' %}
    <svg
      viewBox="0 0 1200 120"
      preserveAspectRatio="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M0,0V120H1200V0Z"
        opacity=".25"
        fill="{{ block.settings.divider_color }}"
      ></path>
      <path
        d="M0,0V90L600,120L1200,90V0Z"
        opacity=".5"
        fill="{{ block.settings.divider_color }}"
      ></path>
      <path
        d="M0,0V60L600,90L1200,60V0Z"
        fill="{{ block.settings.divider_color }}"
      ></path>
    </svg>
  {% elsif block.settings.shape_style == 'tilt' %}
    <svg
      viewBox="0 0 1200 120"
      preserveAspectRatio="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M1200,0H0V120H281.94C572.9,116.24,602.45,3.86,602.45,3.86h0S632,116.24,923,120h277Z"
        fill="{{ block.settings.divider_color }}"
      ></path>
    </svg>
  {% elsif block.settings.shape_style == 'arrow' %}
    <svg
      viewBox="0 0 1200 120"
      preserveAspectRatio="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M649.97,0L550.03,0,0,119.98,0,120,1200,120,1200,119.98Z"
        fill="{{ block.settings.divider_color }}"
      ></path>
    </svg>
  {% elsif block.settings.shape_style == 'split' %}
    <svg
      viewBox="0 0 1200 120"
      preserveAspectRatio="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M0,0V6c0,21.6,291,111.46,741,110.26,445.39,3.6,459-88.3,459-110.26V0Z"
        fill="{{ block.settings.divider_color }}"
      ></path>
    </svg>
  {% elsif block.settings.shape_style == 'book' %}
    <svg
      viewBox="0 0 1200 120"
      preserveAspectRatio="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M1200,0H0V120H281.94C572.9,116.24,602.45,3.86,602.45,3.86h0S632,116.24,923,120h277Z"
        fill="{{ block.settings.divider_color }}"
      ></path>
    </svg>
  {% else %}
    <svg
      viewBox="0 0 1200 120"
      preserveAspectRatio="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z"
        fill="{{ block.settings.divider_color }}"
      ></path>
    </svg>
  {% endif %}
</div>

{% schema %}
{
  "name": "Fluid divider",
  "settings": [
    {
      "type": "header",
      "content": "Shape"
    },
    {
      "type": "select",
      "id": "shape_style",
      "label": "Shape style",
      "options": [
        {
          "value": "waves",
          "label": "Waves"
        },
        {
          "value": "curve",
          "label": "Curve"
        },
        {
          "value": "triangle",
          "label": "Triangle"
        },
        {
          "value": "tilt",
          "label": "Tilt"
        },
        {
          "value": "arrow",
          "label": "Arrow"
        },
        {
          "value": "split",
          "label": "Split"
        },
        {
          "value": "book",
          "label": "Book"
        },
        {
          "value": "slope",
          "label": "Slope"
        }
      ],
      "default": "waves"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Color",
      "default": "#3B8EF8"
    },
    {
      "type": "range",
      "id": "divider_height",
      "label": "Height on desktop",
      "min": 20,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "divider_height_mobile",
      "label": "Height on mobile",
      "min": 20,
      "max": 150,
      "step": 10,
      "unit": "px",
      "default": 50
    },
    {
      "type": "header",
      "content": "Orientation"
    },
    {
      "type": "checkbox",
      "id": "flip_horizontal",
      "label": "Flip horizontal",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "flip_vertical",
      "label": "Flip vertical",
      "default": false
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "spacing_top",
      "label": "Top spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Fluid divider"
    }
  ]
}
{% endschema %}
