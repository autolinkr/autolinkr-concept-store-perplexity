            "highlighted_reveal": false
          }
        },
        "text_AhhiJC": {
          "type": "text",
          "settings": {
            "text": "<p>AutoLinkr Dash Pro™ records the road ahead in 4K UHD and the road behind in 1080P FHD — giving you complete, continuous coverage every moment you're behind the wheel. Loop recording keeps your storage free by automatically overwriting the oldest footage when space runs out, so you're always capturing what's happening now without ever needing to manage files.<\/p><p>Built-in WiFi connects directly to your phone through the AutoLinkr app, where you can preview live, download clips, and share footage in seconds. Built-in GPS embeds location, speed, and route into every recording — so every clip is mapped, timestamped, and ready to share with friends, family, or insurance.<\/p>",
            "text_font": "body",
            "text_size": "text-base",
            "text_max_size": 32,
            "text_line_height": 1.6,
            "text_letter_spacing": 0,
            "text_capitalize": false,
            "secondary_color": false,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "button_VdHjFk": {
