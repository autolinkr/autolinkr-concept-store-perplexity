    "testimonials-2": {
      "type": "testimonials-banner",
      "blocks": {
        "t4": {
          "type": "testimonial",
          "settings": {
            "icon": "quote",
            "text": "<p>\"The 64GB storage is huge for road trips. I downloaded 3 seasons of a show before a drive from LA to Vegas. Kids didn't ask once if we were there yet.\"</p>",
            "author": "Marcus H.",
            "author_info": "2023 Ford Explorer \u2014 Verified Buyer",
