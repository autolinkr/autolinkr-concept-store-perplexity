            "highlighted_reveal": false
          }
        },
        "text_b7X3mk": {
          "type": "text",
          "settings": {
            "text": "<p>We're on a mission to modernize the in-car experience for every driver on the road — not just those who can afford a new vehicle. Cars are getting smarter, but millions of people are still stuck with outdated factory screens that don't keep up with how they live.</p><p>AutoLinkr is changing that. We build technology that bridges the gap between the car you drive and the connected world you live in — wireless CarPlay, seamless streaming, instant setup. Clean. Simple. No dealer visit required.</p><p>We exist at the forefront of in-car technology because we believe every driver deserves a modern experience, without complexity, without compromise, and without buying a new car to get it.</p><p><strong>Smarter driving starts here.</strong></p>",
            "text_font": "body",
            "text_size": "subtext-md",
            "text_max_size": 32,
            "text_line_height": 1.6,
            "text_letter_spacing": 0,
            "text_capitalize": false,
            "secondary_color": false,
            "highlighted_text": "none",
