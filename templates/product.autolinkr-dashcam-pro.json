          }
        },
        "t2": {
          "type": "testimonial",
          "settings": {
            "icon": "quote",
            "text": "<p>\"Crystal-clear footage and easy setup. Even at night, thanks to the STARVIS 2 sensor, details like license plates and road signs are easy to spot. The app makes viewing and downloading clips extremely convenient. Highly recommend.\"<\/p>",
            "author": "Chandaritas",
            "author_info": "Verified Buyer — STARVIS 2 Night Vision",
            "author_url": "",
