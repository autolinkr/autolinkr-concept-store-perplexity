<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
</style>

{{ 'collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'collection.js' | asset_url }}" defer></script>

{%- liquid
  assign filter_count = 0
  for filter in collection.filters
    if filter.type == 'price_range'
      if filter.max_value.value != blank or filter.min_value.value != blank
        assign filter_count = filter_count | plus: 1
      endif
    else
      assign filter_count = filter_count | plus: filter.active_values.size
    endif
  endfor

  assign description   = section.blocks | where: "type", "description"    | first
  assign subcollections = section.blocks | where: "type", "subcollections" | first

  assign enable_sorting    = section.settings.enable_sorting
  assign enable_filtering  = section.settings.enable_filtering
  assign show_on_model     = section.settings.show_on_model
  assign filter_type       = section.settings.filter_type
  assign buttons_style     = section.settings.buttons_style

  assign al_show_rating    = section.settings.show_rating
  assign al_show_save      = section.settings.show_save_amount
  assign al_show_price     = section.settings.show_price
  assign al_show_compare   = section.settings.show_compare_price
  assign al_image_fill     = section.settings.image_fill
  assign al_show_quickadd  = section.settings.show_quick_add
  assign al_show_swatches  = section.settings.show_color_swatches
-%}

{%- if al_show_compare == false -%}
  <style>
    #shopify-section-{{ section.id }} .price__sale .price-item--regular,
    #shopify-section-{{ section.id }} .price-item--regular { display: none !important; }
  </style>
{%- endif -%}

{%- if al_show_price == false -%}
  <style>
    #shopify-section-{{ section.id }} .product-card__bottom,
    #shopify-section-{{ section.id }} .product-card__details .price { display: none !important; }
  </style>
{%- endif -%}

<div class="section section--padding{% if section.settings.divider %} section--divider{% endif %}{% if section.settings.rounded %} section--rounded relative{% endif %}">
  <div class="collection page-width{% if section.settings.full_width %} page-width--full{% endif %} relative{% if enable_filtering %} with-{{ filter_type }}{% endif %}">

    {%- if description != blank and collection.description != blank -%}
      <div class="rte collection__description" {{ description.shopify_attributes }}>
        {{- collection.description -}}
      </div>
    {%- endif -%}

    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if collection.all_products_count > 0 -%}
        {%- render 'facets-sticky',
          results: collection,
          collapsed: section.settings.filter_collapsed,
          enable_color_swatches: section.settings.filter_color_swatches,
          enable_filtering: enable_filtering,
          enable_sorting: enable_sorting,
          filter_count: filter_count,
          section_id: section.id
        -%}
      {%- endif -%}

      {%- if enable_filtering or enable_sorting or subcollections != blank or show_on_model -%}
        <facets-topbar id="FacetsTopbar-{{ section.id }}" class="collection__topbar block xl:sticky z-10" data-gap="0">
          <div class="page-width{% if section.settings.full_width %} page-width--full{% endif %} facet-topbar flex flex-wrap items-center gap-4">
            {%- if enable_filtering and collection.all_products_count > 0 -%}
              {%- if filter_type == 'drawer' -%}
                {%- render 'facets-drawer',
                  results: collection,
                  collapsed: section.settings.filter_collapsed,
                  enable_filtering: enable_filtering,
                  enable_sorting: enable_sorting,
                  enable_color_swatches: section.settings.filter_color_swatches,
                  filter_count: filter_count,
                  buttons_style: buttons_style,
                  section_id: section.id
                -%}
              {%- elsif filter_type == 'sidebar' -%}
                <div class="facet-wrapper hidden xl:block">
                  <button class="button button--{{ buttons_style }} icon-with-text" type="button" is="filters-toggle" aria-controls="FacetFiltersContainer" aria-expanded="true">
                    <span class="btn-fill" data-fill></span>
                    <span class="btn-text">
                      {%- liquid
                        render 'icon', icon: 'filter'
                        echo 'collections.filtering.filter_hide_button' | t
                      -%}
                    </span>
                    <span class="btn-text btn-duplicate">
                      {%- liquid
                        render 'icon', icon: 'filter'
                        echo 'collections.filtering.filter_show_button' | t
                      -%}
                      <facet-count class="facet-count flex items-center justify-center text-xs font-medium rounded-full"{% if filter_count == 0 %} hidden{% endif %}>{{ filter_count }}</facet-count>
                    </span>
                  </button>
                </div>
              {%- endif -%}
            {%- endif -%}

            {%- if subcollections != blank -%}
              {%- render 'subcollections',
                main_menu: subcollections.settings.menu,
                show_count: subcollections.settings.show_count,
                context: 'page'
              -%}
            {%- else -%}
              <p id="ProductCount" class="grow text-base lg:text-lg" role="status">
                {%- liquid
                  if collection.results_count
                    echo 'general.search.results_with_count' | t: terms: collection.terms, count: collection.results_count
                  elsif collection.products_count == collection.all_products_count
                    echo 'collections.general.product_count_simple' | t: count: collection.products_count
                  else
                    echo 'collections.general.product_count' | t: product_count: collection.products_count, count: collection.all_products_count
                  endif
                -%}
              </p>
            {%- endif -%}

            {%- if enable_sorting and collection.all_products_count > 0 -%}
              {%- liquid
                assign sort_by = collection.sort_by | default: collection.default_sort_by
                for option in collection.sort_options
                  if option.value == sort_by
                    assign sort_by_name = option.name
                    break
                  endif
                endfor
              -%}
              <div class="facet-sorting hidden xl:inline-flex items-center gap-6" id="SortByContainer">
                <facet-sort class="sort-wrapper relative">
                  <hover-element class="button button--{{ buttons_style }} sort-by whitespace-nowrap overflow-hidden z-3">
                    <span class="btn-fill" data-fill></span>
                    <div class="btn-text">
                      <span class="sort-header flex items-center justify-center gap-5 relative w-full">
                        <span class="sort-selection">{{ sort_by_name | escape }}</span>
                        <span class="sort-title text-sm uppercase absolute left-0 opacity-0 tracking-widest">{{ 'collections.sorting.sort_button' | t }}</span>
                        <span class="sort-close flex items-center justify-center rounded-full">
                          {%- render 'icon', icon: 'close', size: 'sm' -%}
                        </span>
                      </span>
                      <ul class="sort-listbox text-left grid gap-2 absolute left-0 opacity-0 invisible w-full h-auto">
                        {%- for option in collection.sort_options -%}
                          <li class="opacity-0 relative">
                            <input id="SortBy-{{ option.value }}-{{ section.id }}" class="sr-only" name="sort_by" type="radio" value="{{ option.value }}"{% if option.value == sort_by %} checked{% endif %} />
                            <label for="SortBy-{{ option.value }}-{{ section.id }}" class="reversed-link text-xl">{{ option.name | escape }}</label>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>
                  </hover-element>
                </facet-sort>
              </div>
            {%- endif -%}
          </div>
          {%- if section.settings.rounded -%}
            {%- render 'corner', dir: 'bottom', border: true, prefix: 'collection' -%}
          {%- else -%}
            <span class="collection__cutout cutout opacity-0 absolute left-0 top-100 w-full pointer-events-none"></span>
          {%- endif -%}
        </facets-topbar>
      {%- endif -%}

      {%- liquid
        if enable_filtering
          render 'facets-active', results: collection, enable_color_swatches: section.settings.filter_color_swatches, filter_count: filter_count
        endif
      -%}

      <div class="collection__content flex">
        {%- if enable_filtering and filter_type == 'sidebar' and collection.all_products_count > 0 -%}
          <div class="hidden xl:block" id="FacetFiltersContainer">
            <sticky-element class="facets__scroll block xl:sticky top-0" aria-controls="FacetsTopbar-{{ section.id }}">
              {%- render 'facets',
                context: 'sidebar',
                results: collection,
                collapsed: section.settings.filter_collapsed,
                enable_filtering: enable_filtering,
                enable_sorting: false,
                enable_color_swatches: section.settings.filter_color_swatches,
                section_id: section.id
              -%}
            </sticky-element>
          </div>
        {%- endif -%}

        <div class="flex flex-col gap-12 grow" id="ProductGridContainer">
          {%- if collection.products.size == 0 -%}
            <div class="empty-state grid items-center justify-center text-center gap-7d5">
              {%- if collection.all_products_count > 0 -%}
                <div class="flex flex-col items-center gap-3">
                  {%- render 'icon', icon: 'empty', size: 'xxxl' -%}
                  <p class="heading leading-none tracking-tight">{{ 'collections.general.no_results' | t }}</p>
                  <p>{{ 'collections.general.use_fewer_filters' | t }}</p>
                </div>
                <a class="button button--primary icon-with-text" href="{{ collection.url }}" is="facet-remove" data-magnet="0">
                  <span class="btn-fill" data-fill></span>
                  <span class="btn-text">
                    {%- liquid
                      render 'icon', icon: 'close-2', size: 'xxxs'
                      echo 'collections.filtering.clear_all' | t
                    -%}
                  </span>
                </a>
              {%- else -%}
                <div class="flex flex-col items-center gap-3">
                  {%- render 'icon', icon: 'empty', size: 'xxxl' -%}
                  <p class="heading leading-none tracking-tight">{{ 'collections.general.empty' | t }}</p>
                </div>
                <a class="button button--primary icon-with-text" href="{{ routes.all_products_collection_url }}" is="hover-link">
                  <span class="btn-fill" data-fill></span>
                  <span class="btn-text">{{ 'collections.general.continue_shopping' | t }}</span>
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if collection.all_products_count > 0 -%}
            <motion-list class="card-grid card-grid--{{ section.settings.columns }} mobile:card-grid--{{ section.settings.columns_mobile }} grid relative">
              {%- for product in collection.products -%}
                {%- liquid
                  assign lazy_load = false
                  if forloop.index > 2
                    assign lazy_load = true
                  endif
                -%}
                {%- render 'product-card',
                  product: product,
                  product_id: product.id,
                  section_id: section.id,
                  lazy_load: lazy_load,
                  image_ratio: 'square',
                  image_fill: al_image_fill,
                  show_secondary_image: true,
                  show_multiple_images: false,
                  show_vendor: false,
                  title_truncation: true,
                  title_line_limit: 2,
                  show_rating: al_show_rating,
                  show_color_swatches: al_show_swatches,
                  show_countdown: false,
                  show_quick_add: al_show_quickadd,
                  show_quick_view: false,
                  vertical_badges: false,
                  show_sold_out: true,
                  show_save_amount: al_show_save,
                  save_type: 'percent',
                  show_icon_list: false,
                  show_on_model: show_on_model
                -%}
              {%- endfor -%}
            </motion-list>
            {%- liquid
              if paginate.pages > 1
                render 'pagination', paginate: paginate, mode: section.settings.pagination
              endif
            -%}
          {%- endif -%}
        </div>
      </div>
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "AL — Product Grid",
  "class": "collection-section",
  "settings": [
    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 6,
      "max": 50,
      "step": 1,
      "default": 12,
      "label": "Products per page"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3,
      "label": "Columns (desktop)"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "Columns (mobile)",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ]
    },
    {
      "type": "select",
      "id": "pagination",
      "default": "paginated",
      "label": "Pagination",
      "options": [
        { "value": "infinite", "label": "Infinite scroll" },
        { "value": "click",    "label": "Load more button" },
        { "value": "paginated","label": "Page numbers" }
      ]
    },
    {
      "type": "header",
      "content": "Card — Image"
    },
    {
      "type": "checkbox",
      "id": "image_fill",
      "default": true,
      "label": "Fill image to card frame",
      "info": "Image expands to fill the full card. Uncheck for contained/padded image."
    },
    {
      "type": "header",
      "content": "Card — Pricing"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "default": true,
      "label": "Show price"
    },
    {
      "type": "checkbox",
      "id": "show_compare_price",
      "default": true,
      "label": "Show compare-at (original) price",
      "info": "Shows the strikethrough original price when a product is on sale."
    },
    {
      "type": "checkbox",
      "id": "show_save_amount",
      "default": true,
      "label": "Show sale badge (SAVE %)"
    },
    {
      "type": "header",
      "content": "Card — Details"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": true,
      "label": "Show product rating"
    },
    {
      "type": "checkbox",
      "id": "show_color_swatches",
      "default": true,
      "label": "Show color swatches"
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "default": false,
      "label": "Show quick add button"
    },
    {
      "type": "header",
      "content": "Filtering & Sorting"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "Enable filtering"
    },
    {
      "type": "select",
      "id": "filter_type",
      "label": "Filter style",
      "default": "drawer",
      "options": [
        { "value": "drawer",  "label": "Drawer" },
        { "value": "sidebar", "label": "Sidebar" }
      ]
    },
    {
      "type": "checkbox",
      "id": "filter_collapsed",
      "label": "Collapse filters by default",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "filter_color_swatches",
      "label": "Color swatches in filters",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Enable sorting",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_model",
      "default": false,
      "label": "Show on model toggle"
    },
    {
      "type": "select",
      "id": "buttons_style",
      "default": "secondary",
      "label": "Filter button style",
      "options": [
        { "value": "primary",   "label": "Primary" },
        { "value": "secondary", "label": "Secondary" }
      ]
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 120, "step": 4, "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 120, "step": 4, "unit": "px",
      "label": "Padding bottom",
      "default": 36
    },
    {
      "type": "checkbox",
      "id": "divider",
      "label": "Show divider",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "rounded",
      "default": false,
      "label": "Rounded corners"
    }
  ],
  "blocks": [
    {
      "type": "description",
      "name": "Collection description",
      "limit": 1
    },
    {
      "type": "subcollections",
      "name": "Subcollections",
      "limit": 1,
      "settings": [
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        },
        {
          "type": "checkbox",
          "id": "show_count",
          "label": "Show product count",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AL — Product Grid"
    }
  ]
}
{% endschema %}
