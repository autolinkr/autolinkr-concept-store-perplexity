            "icon": "none",
            "heading": "Shipping",
            "content": "<p>You can expect your <strong>AutoLinkr Lite™</strong> within 5-10 business days from your order date.</p>",
            "page": "",
            "liquid": "",
            "text_size": "text-sm"
          }
