        "tab-description": {
          "type": "collapsible_tab",
          "settings": {
            "opened": false,
            "style": "with-border",
            "icon": "none",
            "heading": "Description",
            "content": "<p>AutoLinkr Lite\u2122 brings wireless CarPlay and Android Auto to your factory screen \u2014 no cables, no appointments, no hassle. Plug it into your car's USB port once, pair via Bluetooth, and it auto-connects every drive.</p><p>The full Google Play Store means Netflix, YouTube, Hulu, Disney+, Spotify, and thousands more apps run natively on your factory display. AutoLinkr Lite\u2122 is the essential wireless CarPlay upgrade for drivers who want streaming without the premium price tag.</p>",
            "page": "",
            "liquid": "",
            "text_size": "text-sm"
          }
        },
        "tab-compatibility": {
          "type": "collapsible_tab",
          "settings": {
            "opened": false,
            "style": "with-border",
            "icon": "none",
            "heading": "Compatibility",
            "content": "<p>Works with any 2016+ vehicle with factory Apple CarPlay or Android Auto \u2014 500+ models from Toyota, Honda, Ford, Chevrolet, Mercedes, Hyundai, Kia, Nissan, Subaru, Mazda, Volkswagen, Audi, and 30+ more manufacturers.</p><p>Not compatible with: Tesla, Rivian, Lucid, NIO.</p><p><a href=\"/pages/supported-cars\">Check Your Car \u2192</a></p>",
            "page": "",
            "liquid": "",
            "text_size": "text-sm"
          }
        },
        "tab-specs": {
          "type": "collapsible_tab",
          "settings": {
            "opened": false,
            "style": "with-border",
            "icon": "none",
            "heading": "What's Included",
            "content": "<p>\u2714 AutoLinkr Lite\u2122<br/>\u2714 USB-C to USB-A Cable<br/>\u2714 USB-C to USB-C Cable<br/>\u2714 User Manual</p>",
            "page": "",
            "liquid": "",
            "text_size": "text-sm"
          }
        },
        "tab-shipping": {
          "type": "collapsible_tab",
          "settings": {
            "opened": false,
            "style": "with-border",
            "icon": "none",
            "heading": "Shipping & Returns",
            "content": "<p>FREE standard shipping on all orders (6-10 business days). Most orders placed before 2pm ET ship the same day.</p><p>30-day money-back guarantee \u2014 return for full in-store credit. We cover return shipping.</p><p>1-Year Warranty \u2014 covered against manufacturing defects.</p><p><a href=\"mailto:support@theautolinkr.com\">support@theautolinkr.com</a></p>",
            "page": "",
            "liquid": "",
            "text_size": "text-sm"
          }
        },
        "text-safety": {
          "type": "text",
          "settings": {
            "icon": "none",
            "iwidth": "custom",
            "icon_width": 24,
            "text": "\u26a0\ufe0f Always operate your vehicle safely and in compliance with all applicable traffic and distracted-driving laws. Video playback is intended for passengers or when the vehicle is parked. The driver is solely responsible for safe and lawful vehicle operation at all times.",
            "text_size": "text-xs"
          }
