{% comment %}
  AutoLinkr — standalone “Watch setup” CTA (separate from How It Works).
{% endcomment %}
<section
  class="al-setup-video-cta"
  style="background: rgb(var(--color-base-background)); padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width" style="max-width: 1200px; margin: 0 auto; padding: 0 24px; text-align: center;">
    {%- if section.settings.heading != blank -%}
      <h2 class="al-setup-video-cta__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="al-setup-video-cta__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
      <a href="{{ section.settings.cta_link }}" class="button button--primary al-setup-video-cta__btn">
        {{- section.settings.cta_label -}}
        {%- unless section.settings.cta_label contains '→' or section.settings.cta_label contains '▶' -%}
          <span aria-hidden="true"> →</span>
        {%- endunless -%}
      </a>
    {%- endif -%}
  </div>
</section>

<style>
  .al-setup-video-cta__heading {
    font-family: var(--al-font-display, 'General Sans', sans-serif);
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    font-weight: 700;
    color: var(--al-text-1);
    margin: 0 0 8px;
    letter-spacing: -0.02em;
  }
  .al-setup-video-cta__sub {
    color: var(--al-text-3);
    font-size: 0.9375rem;
    line-height: 1.6;
    max-width: 520px;
    margin: 0 auto 20px;
  }
  .al-setup-video-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    padding: 14px 32px;
    border: none !important;
    box-shadow: none !important;
  }
  .al-setup-video-cta__btn:hover {
    box-shadow: none !important;
    transform: none !important;
  }
  .js [data-button-hover='standard'] .al-setup-video-cta .button--primary:hover:not([disabled], .self-button) {
    box-shadow: none !important;
    transform: none !important;
  }
</style>

{% schema %}
{
  "name": "AL — Setup video CTA",
  "tag": "section",
  "settings": [
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 8, "max": 80, "step": 4, "default": 24, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 8, "max": 80, "step": 4, "default": 24, "unit": "px" },
    { "type": "text", "id": "heading", "label": "Heading (optional)" },
    { "type": "textarea", "id": "subheading", "label": "Subheading (optional)" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "▶ Watch Setup Video" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [{ "name": "AL — Setup video CTA" }],
  "disabled_on": { "groups": ["footer", "header", "custom.overlay"] }
}
{% endschema %}
