          }
        },
        "t3": {
          "type": "testimonial",
          "settings": {
            "icon": "quote",
            "text": "<p>\"Six cameras for the family fleet. Within a couple days of installation, someone stepped out in front of me in traffic — had I not been able to miss him, the 4K footage would have proven I was not at fault. Worth every dollar.\"<\/p>",
            "author": "HamRadio.World",
