    "faq_E4tci4": {
      "type": "faq",
      "blocks": {
        "question_xH9dRz": {
          "type": "question",
          "settings": {
            "title": "How is the Dash Pro different from the regular Dash?",
            "text": "<p>The Dash Pro records in true 4K UHD up front (vs 1080P) and uses the STARVIS 2 image sensor for dramatically better low-light performance. It also adds built-in GPS — so location, speed, and route are embedded in every clip.<\/p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_UEKLiJ": {
          "type": "question",
          "settings": {
            "title": "What SD card does it use?",
            "text": "<p>A 64GB SD card is included in the box. The Dash Pro supports cards up to 256GB if you want to extend record time before loop overwrite — recommended for road trips and cross-country driving.<\/p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_jNxHfP": {
          "type": "question",
          "settings": {
            "title": "Will it work with my vehicle?",
            "text": "<p>Yes — the Dash Pro is a universal dash camera designed for any 12–24V vehicle. It works in cars, SUVs, trucks, and vans regardless of make or model.<\/p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_phone": {
          "type": "question",
          "settings": {
            "title": "Does it connect to my phone?",
            "text": "<p>Yes. The Dash Pro has built-in WiFi and pairs directly with your iPhone or Android through the AutoLinkr app — preview live footage, download clips, and share to your camera roll without removing the SD card.<\/p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_frontrear": {
          "type": "question",
          "settings": {
            "title": "Does it record front and rear at the same time?",
            "text": "<p>Yes. The Dash Pro records 4K UHD (3840×2160) up front and 1080P FHD behind, simultaneously and continuously, every time the car is on.<\/p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_cloud": {
          "type": "question",
          "settings": {
            "title": "How does 24H Parking Monitor work?",
            "text": "<p>Parking Monitor requires the optional hardwire kit, which connects the camera directly to your fuse box with a low-voltage cutoff to protect your battery. Once installed, the camera stays on after you park and records when motion or impact is detected, or in low-power time-lapse for full-day coverage.<\/p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
