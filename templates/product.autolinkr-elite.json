        "collapsible-description": {
          "type": "collapsible_tab",
          "settings": {
            "opened": false,
            "style": "with-border",
            "icon": "none",
            "heading": "Description",
            "content": "<p>AutoLinkr Elite\u2122 is our most powerful CarPlay adapter ever built. Everything in Pro\u2014wireless CarPlay, Android Auto, and full Google Play streaming\u2014plus split-screen multitasking that no other adapter can do.</p><p>Navigate with Waze on one half of your screen while Netflix runs on the other. 8GB of RAM and a faster processor mean smooth performance, no lag, and zero dropped connections\u2014even with multiple apps running.</p><p>64GB of onboard storage means your downloaded shows, playlists, and offline maps are always there. Plug in once. It auto-connects every drive after. This is the last car upgrade you'll ever need.</p>",
            "page": "",
            "liquid": "",
            "text_size": "text-sm"
          }
        },
        "collapsible-compatibility": {
          "type": "collapsible_tab",
          "settings": {
            "opened": false,
            "style": "with-border",
            "icon": "none",
            "heading": "Compatibility",
            "content": "<p>Works with any 2016+ vehicle with factory Apple CarPlay or Android Auto.</p><p>Compatible with 500+ models from Toyota, Honda, Ford, Chevrolet, Mercedes, Hyundai, Kia, Nissan, Subaru, Mazda, Volkswagen, Audi, and 30+ more manufacturers.</p><p>Not compatible with: Tesla, Rivian, Lucid, NIO.</p><p><a href=\"/pages/supported-cars\">Check Your Car \u2192</a></p><p>Not sure? Contact us and we'll confirm in minutes.</p>",
            "page": "",
            "liquid": "",
            "text_size": "text-sm"
          }
        },
        "collapsible-specs": {
          "type": "collapsible_tab",
          "settings": {
            "opened": false,
            "style": "with-border",
            "icon": "none",
            "heading": "What's Included",
            "content": "<p>\u2714 AutoLinkr Elite\u2122<br/>\u2714 USB-C to USB-A Cable<br/>\u2714 USB-C to USB-C Cable<br/>\u2714 User Manual</p>",
            "page": "",
            "liquid": "",
            "text_size": "text-sm"
          }
        },
        "collapsible-shipping": {
          "type": "collapsible_tab",
          "settings": {
            "opened": false,
            "style": "with-border",
            "icon": "none",
            "heading": "Shipping & Returns",
            "content": "<p>FREE standard shipping on all orders (6-10 business days). Most orders placed before 2pm ET ship the same day.</p><p>30-day money-back guarantee \u2014 if AutoLinkr doesn't work with your car or you're not satisfied, return it for full in-store credit. We cover return shipping.</p><p>Lifetime customer support: support@theautolinkr.com</p>",
            "page": "",
            "liquid": "",
            "text_size": "text-sm"
          }
        },
        "text-safety": {
